+(* Keep the non-null pattern and pointer kind distinct; region comparison
+   continues through the complete pointee type, including its metadata. *)
+let compare_notnull_pointer_pointees span compare ty1 ty2 =
+  match ty1,ty2 with
+  | TPattern(TRawPtr(p1,k1),NotNull),TPattern(TRawPtr(p2,k2),NotNull) ->
+      [%cassert_opt_span] span (k1=k2) "Non-null pointer comparison kind mismatch";
+      Some(compare p1 p2)
+  | _ -> None
+
