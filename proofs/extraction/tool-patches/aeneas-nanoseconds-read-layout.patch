+(* Isolated native-target candidate: only the actual transparent Nanoseconds read.
+   The reverse unsafe constructor remains unsupported; no validity is invented. *)
+let supported_nanoseconds_read (decls : type_decl TypeDeclId.Map.t)
+    (src : ty) (tgt : ty) : bool =
+  let u32 = TScalar (TInteger (Unsigned U32)) in
+  let chosen_four (s : size) = match s.chosen with
+    | Some (SizeExprConstant {kind = CInteger (UnsignedInteger (Usize, n));
+                             ty = TScalar (TInteger (Unsigned Usize))}) -> Z.equal n (Z.of_int 4)
+    | _ -> false in
+  let layout_ok (target, (l : layout)) =
+    target = "aarch64-apple-darwin" && chosen_four l.size && chosen_four l.align
+    && l.repr.transparent && l.repr.align_modif = None
+    && l.repr.repr_algo = Rust && l.repr.explicit_discr_type = None
+    && l.inhabited = InhabitedPredicateTrue
+    && (match l.discriminator, l.variant_layouts with
+        | Some (Known variant), [Some v] ->
+            VariantId.to_int variant = 0 && v.inhabited = InhabitedPredicateTrue
+            && v.tagger = [] && (match v.field_offsets with
+               | [{chosen = Some 0; _}] -> true | _ -> false)
+        | _ -> false) in
+  match src with
+  | TAdt {id; builtin = None; generics} when tgt = u32
+      && generics = Charon.TypesUtils.empty_generic_args -> (
+      match TypeDeclId.Map.find_opt id decls with
+      | Some d when d.generics = Charon.TypesUtils.empty_generic_params
+          && d.ptr_metadata = NoMetadata
+          && List.filter_map (function PeIdent (n, _) -> Some n | _ -> None)
+               d.item_meta.name = ["core"; "num"; "niche_types"; "Nanoseconds"]
+          && d.layout <> [] && List.for_all layout_ok d.layout -> (
+          match d.kind with
+          | Struct [{field_ty = TPattern (base, (Range (lo, hi) as pat)); _}] ->
+              supported_u32_range_pattern base pat
+              && (match lo.kind, hi.kind with
+                  | CInteger (UnsignedInteger (U32, lo)), CInteger (UnsignedInteger (U32, hi)) ->
+                      Z.equal lo Z.zero && Z.equal hi (Z.of_int 999999999)
+                  | _ -> false)
+          | _ -> false)
       | _ -> false)
   | _ -> false
 
