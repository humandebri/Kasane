 (** Small helper *)
+(* Function value types retain local binders but reject free lifetimes. *)
+let fn_regions_are_ety ty =
+  let visitor = object
+    inherit [_] iter_ty as super
+    method! visit_region scopes r =
+      match r with
+      | RErased | RStatic -> ()
+      | RVar (Bound (depth,id)) ->
+          if depth < 0 || RegionId.to_int id < 0 then raise Found;
+          (match List.nth_opt scopes depth with
+           | Some count when RegionId.to_int id < count -> ()
+           | _ -> raise Found)
+      | RVar (Free _) -> raise Found
+      | RBody _ -> [%craise_opt_span] None "unsupported: Body region"
+    method! visit_region_binder visit_value scopes x =
+      let ids = List.map (fun (p : region_param) -> RegionId.to_int p.index) x.binder_regions in
+      if ids <> List.init (List.length ids) Fun.id then raise Found;
+      super#visit_region_binder visit_value (List.length ids :: scopes) x
+    method! visit_binder visit_value scopes x =
+      let ids = List.map (fun (p : region_param) -> RegionId.to_int p.index) x.binder_params.regions in
+      if ids <> List.init (List.length ids) Fun.id then raise Found;
+      super#visit_binder visit_value (List.length ids :: scopes) x
+  end in
+  try visitor#visit_ty [] ty; true with Found -> false
+
 let raise_if_not_erased_ty_visitor =
