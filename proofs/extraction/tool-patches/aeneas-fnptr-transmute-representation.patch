+(* Representation-only cast. Unsafe call ABI/provenance/receiver obligations
+   are separate and are not discharged by preserving this symbolic operation. *)
+let fnptr_transmute_representation_supported (src : ty) (dst : ty) : bool =
+  match (src, dst) with
+  | TFnPtr source, TFnPtr target ->
+      TypesUtils.ty_is_rty src && TypesUtils.ty_is_rty dst
+      && source.binder_value.abi = AbiRust
+      && target.binder_value.abi = AbiRust
+      && not source.binder_value.is_variadic
+      && not target.binder_value.is_variadic
+      && target.binder_value.is_unsafe
+      && List.length source.binder_value.inputs = List.length target.binder_value.inputs
+      && source.binder_value.output = target.binder_value.output
+  | _ -> false
+
