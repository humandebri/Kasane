 (** The local logger *)
 let log = Logging.symbolic_to_pure_types_log
+
+(* Bound regions and ABI remain intact. Open signatures require a
+   substitution-aware representation and remain unsupported. *)
+let supported_closed_rust_fnptr (s : T.fun_sig T.region_binder) : bool =
+  let sg = s.binder_value in
+  let ids = List.map (fun (r : T.region_param) -> T.RegionId.to_int r.index) s.binder_regions in
+  if sg.abi <> T.AbiRust || sg.is_variadic
+     || ids <> List.init (List.length ids) Fun.id then false
+  else
+    let visitor = object
+      inherit [_] T.iter_ty as super
+      method! visit_ty () ty =
+        (match ty with
+         | T.TVar _ | T.TTraitType _ | T.TDynTrait _ | T.TFnDef _ | T.TFnPtr _
+         | T.TError _ | T.TPattern _ | T.TArray _ | T.TSlice _ -> raise Utils.Found
+         | _ -> ());
+        super#visit_ty () ty
+      method! visit_region () r =
+        match r with
+        | T.RStatic -> ()
+        | T.RVar (T.Bound (0, id)) when 0 <= T.RegionId.to_int id && T.RegionId.to_int id < List.length ids -> ()
+        | _ -> raise Utils.Found
+      method! visit_generic_args () g =
+        if g.const_generics <> [] || g.trait_refs <> [] then raise Utils.Found;
+        super#visit_generic_args () g
+    end in
+    try List.iter (visitor#visit_ty ()) (sg.inputs @ [sg.output]); true
+    with Utils.Found -> false
+
+let translate_closed_rust_fnptr span s =
+  [%cassert_opt_span] span
+    (Config.backend () = Config.Lean && supported_closed_rust_fnptr s)
+    "Unsupported open or non-Rust function pointer signature";
+  TAdt (TBuiltin (TRustFnPtr s),
+    {types = []; const_generics = []; trait_refs = []})
+
 
