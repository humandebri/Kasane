+
+(* Only classify constant U32 ranges. The original range type is not rewritten. *)
+let supported_u32_range_pattern (ty : ty) (pat : type_pattern) : bool =
+  match (ty, pat) with
+  | TScalar (TInteger (Unsigned U32)), Range (lo, hi) -> (
+      match (lo.kind, hi.kind) with
+      | CInteger (UnsignedInteger (U32, lo_value)),
+        CInteger (UnsignedInteger (U32, hi_value)) ->
+          lo.ty = ty && hi.ty = ty && Z.sign lo_value >= 0
+          && Z.leq lo_value hi_value
+          && Z.lt hi_value (Z.shift_left Z.one 32)
+      | _ -> false)
+  | _ -> false
 
