+(* Validate using the existing closed-shape guard, then abstract only free
+   type variables. No erased validation probe is stored or exported. *)
+let split_rust_fnptr_template (s : T.fun_sig T.region_binder) =
+  let vars=ref T.TypeVarId.Set.empty and valid=ref true in
+  let probe=object
+    inherit [_] T.map_ty as super
+    method! visit_ty () ty = match ty with
+      | T.TVar(T.Free id) ->
+          if T.TypeVarId.to_int id<0 then valid:=false;
+          vars:=T.TypeVarId.Set.add id !vars; T.TNever
+      | _ -> super#visit_ty () ty
+  end in
+  let closed_probe=probe#visit_region_binder probe#visit_fun_sig () s in
+  let ids=T.TypeVarId.Set.elements !vars in
+  if not !valid || ids=[] || not(supported_closed_rust_fnptr closed_probe) then None
+  else
+    let positions=List.mapi(fun index id -> id,index) ids in
+    let abstract=object
+      inherit [_] T.map_ty as super
+      method! visit_ty () ty = match ty with
+        | T.TVar(T.Free id) -> T.TVar(T.Bound(0,T.TypeVarId.of_int(List.assoc id positions)))
+        | _ -> super#visit_ty () ty
+    end in
+    let signature=abstract#visit_region_binder abstract#visit_fun_sig () s in
+    Some({template_signature=signature;template_type_slots=List.length ids},
+      List.map(fun id -> T.TVar(T.Free id)) ids)
+
