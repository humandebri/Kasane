+  let scoped=List.for_all(function T.RStatic -> true
+    | T.RVar(T.Bound(0,id)) -> 0<=T.RegionId.to_int id && T.RegionId.to_int id<List.length ids
+    | _ -> false) metadata.item_region_args in
+  let erased=List.map(fun _ -> T.RErased) metadata.item_region_args in
+  ids=List.init(List.length ids) Fun.id && scoped && erased=value_regions
+  && Charon.Substitute.lookup_method_sig crate metadata.item_trait_id metadata.item_method_id<>None
+  && generics.const_generics=[] && List.length generics.types=1
+  && ty=TAdt(TBuiltin(TRustTraitFnItem metadata),generics)
+  && match generics.trait_refs with
+     | [tr] -> tr.trait_decl_ref.trait_decl_id=metadata.item_trait_id
+         && tr.trait_decl_ref.decl_generics.types=generics.types
+         && tr.trait_decl_ref.decl_generics.const_generics=[]
+         && tr.trait_decl_ref.decl_generics.trait_refs=[]
+     | _ -> false
