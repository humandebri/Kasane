+(* The source constant's body regions have undergone normal erasure.
+   Preserve that value instantiation separately from its higher-ranked type. *)
+let translate_rust_trait_fn_item_value span crate raw_ty (value : T.fn_ptr) expected_ty =
+  [%cassert_opt_span] span (Config.backend ()=Config.Lean)
+    "Trait function-item values require Lean";
+  let source=match raw_ty with T.TFnDef f -> f
+    | _ -> [%craise_opt_span] span "Unsupported trait function-item value type" in
+  let metadata,_=[%unwrap_opt_span] span (split_open_trait_fn_item source)
+    "Unsupported trait function-item value template" in
+  let source_value=source.binder_value in
+  let expected_regions=List.map(fun _ -> T.RErased) source_value.generics.regions in
+  [%cassert_opt_span] span
+    (value.kind=source_value.kind && value.generics={source_value.generics with regions=expected_regions}
+     && Charon.Substitute.lookup_fndef_sig crate source<>None)
+    "Trait function-item value identity/instantiation mismatch";
+  let ty=translate_sty span raw_ty in
+  [%cassert_opt_span] span (ty=expected_ty) "Trait function-item value expected type mismatch";
+  let generics=match ty with TAdt(TBuiltin(TRustTraitFnItem _),g) -> g | _ -> [%craise_opt_span] span "Unsupported trait function-item Pure type" in
+  [%cassert_opt_span] span (PureTypeCheck.rust_trait_fn_item_value_type_matches
+    crate metadata value.generics.regions generics ty) "Malformed trait function-item value captures";
+  {e=Qualif{id=RustTraitFnItemValue(metadata,value.generics.regions);generics};ty}
 
