+(* Recover pointee-region metadata from the actual symbolic loan. This is
+   a type correspondence only; the existing unary-op AST retains its shared
+   borrow operand and cast, and executable pointer extraction is still blocked. *)
+let array_ref_nonnull_symbolic_type crate src dst (loan : symbolic_value) =
+  if not(array_ref_nonnull_representation_supported crate src dst
+         && TypesUtils.ty_is_rty loan.sv_ty) then None
+  else match src,dst,loan.sv_ty with
+    | TRef(_,array_ty,RShared),TAdt r,TArray(elem,_,None)
+        when TypesUtils.ty_erase_regions loan.sv_ty=array_ty ->
+        let result=TAdt{r with generics={r.generics with types=[elem]}} in
+        if TypesUtils.ty_is_rty result then Some result else None
+    | _ -> None
+
 let eval_unary_op_symbolic (config : config) (span : Meta.span) (unop : unop)
     (op : operand) (ctx : eval_ctx) :
     (tvalue, eval_error) result
