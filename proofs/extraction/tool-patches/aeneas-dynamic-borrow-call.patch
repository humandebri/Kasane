+let dynamic_borrow_signature span types const_generics ty : bound_fun_sig =
+  let pointer = match ty with
+    | TFnPtr pointer -> pointer
+    | _ -> [%craise] span "Dynamic callee is not a function pointer" in
+  let sg = pointer.binder_value in
+  [%cassert] span
+    (not sg.is_unsafe && sg.abi = AbiRust && not sg.is_variadic
+     && List.length pointer.binder_regions = 1
