+      | RVar (Bound (0, id)) when id = RegionId.of_int 0 -> RVar (Free id)
+      | _ -> [%craise] span "Captured/erased dynamic callback region unsupported"
+  end in
+  let sg = visitor#visit_fun_sig () sg in
