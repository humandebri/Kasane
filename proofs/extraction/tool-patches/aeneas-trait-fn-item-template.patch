+  let ids=List.map (fun (r : T.region_param) -> T.RegionId.to_int r.index) f.binder_regions in
+  let g=f.binder_value.generics in
+  let scoped = List.for_all (function
+    | T.RStatic -> true
+    | T.RVar(T.Bound(0,id)) -> 0 <= T.RegionId.to_int id && T.RegionId.to_int id < List.length ids
