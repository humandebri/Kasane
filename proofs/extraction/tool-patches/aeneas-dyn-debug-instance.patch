+    | Some t -> names t.item_meta.name = name | None -> false in
+  let no_extra (g : generic_params) =
+    g.types = [] && g.const_generics = [] && g.trait_clauses = [] &&
+    g.regions_outlive = [] && g.types_outlive = [] && g.trait_type_constraints = [] in
+  let formatter = function
