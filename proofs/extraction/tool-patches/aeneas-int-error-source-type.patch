+(* Reject opaque/changed error definitions before bypassing the Unit builtin. *)
+let supported_try_from_int_error (decls : type_decl TypeDeclId.Map.t)
+    (d : type_decl) : bool =
+  let names (d : type_decl) = List.filter_map
+    (function PeIdent (n, _) -> Some n | _ -> None) d.item_meta.name in
+  let empty (d : type_decl) = d.generics = Charon.TypesUtils.empty_generic_params
+                && d.ptr_metadata = NoMetadata in
+  names d = ["core"; "num"; "error"; "TryFromIntError"] && empty d
+  && (match d.kind with
+      | Struct [{field_ty = TAdt {id; builtin = None; generics}; _}]
+        when generics = Charon.TypesUtils.empty_generic_args -> (
+          match TypeDeclId.Map.find_opt id decls with
+          | Some payload when names payload = ["core"; "num"; "error"; "IntErrorKind"]
+              && empty payload -> (
+              match payload.kind with
+              | Enum variants ->
+                  let expected = ["Empty"; "InvalidDigit"; "PosOverflow";
+                                  "NegOverflow"; "Zero"; "NotAPowerOfTwo"] in
+                  List.length variants = List.length expected
+                  && List.for_all2 (fun (i, (v : variant)) name ->
+                       v.variant_name = name && v.fields = []
+                       && VariantId.to_int v.id = i
+                       && v.discriminant = SignedInteger (Isize, Z.of_int i))
+                       (List.mapi (fun i v -> i, v) variants) expected
+              | _ -> false)
+          | _ -> false)
+      | _ -> false)
 
