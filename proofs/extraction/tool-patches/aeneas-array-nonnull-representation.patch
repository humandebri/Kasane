+(* This classifies a retained representation cast, not allocation validity,
+   provenance, dereference safety, or a Rust-to-Lean memory correspondence. *)
+let array_ref_nonnull_representation_supported (crate : LlbcAst.crate) src dst =
+  let no_extra (g : generic_args) =
+    g.regions=[] && g.const_generics=[] && g.trait_refs=[] in
+  let sized t = match t with
+    | TScalar _ -> true
+    | TAdt r when r.builtin=None ->
+        (match TypeDeclId.Map.find_opt r.id crate.type_decls with
+         | Some d -> d.ptr_metadata=NoMetadata | None -> false)
+    | _ -> false in
+  match src,dst with
+  | TRef(_,TArray(elem,len,None),RShared),TAdt r
+      when r.builtin=None && no_extra r.generics && r.generics.types=[elem]
+        && len.ty=TScalar(TInteger(Unsigned Usize)) && sized elem ->
+      (match TypeDeclId.Map.find_opt r.id crate.type_decls with
+       | Some d ->
+           let g=d.generics in
+           let expected=TVar(Free(TypeVarId.of_int 0)) in
+           let field=TPattern(TRawPtr(expected,RShared),NotNull) in
+           let sz=SizeExprConstant {kind=CSizeOf field;ty=TScalar(TInteger(Unsigned Usize))}
+           and al=SizeExprConstant {kind=CAlignOf field;ty=TScalar(TInteger(Unsigned Usize))} in
+           d.item_meta.name=List.map(fun n -> PeIdent(n,Disambiguator.zero)) ["core";"ptr";"non_null";"NonNull"]
+           && d.ptr_metadata=NoMetadata && d.src=NormalType
+           && g.regions=[] && g.const_generics=[] && g.trait_clauses=[]
+           && g.regions_outlive=[] && g.types_outlive=[] && g.trait_type_constraints=[]
+           && (match g.types with [p] -> p.index=TypeVarId.of_int 0 && p.variance=Covariant | _ -> false)
+           && (match d.kind with Struct[f] -> f.field_ty=field && f.field_name="pointer" | _ -> false)
+           && (match d.layout with
+               | [("aarch64-apple-darwin",l)] ->
+                   l.repr={repr_algo=Rust;align_modif=None;transparent=true;explicit_discr_type=None}
+                   && l.size={chosen=None;guarantee=Some sz}
+                   && l.align={chosen=None;guarantee=Some al}
+                   && l.discriminator=None
+                   && (match l.variant_layouts with
+                       | [Some v] -> v.tagger=[] && v.field_offsets=[{chosen=None;guarantee=Some(GuaranteedAlignment al)}]
+                       | _ -> false)
+               | _ -> false)
+       | None -> false)
+  | _ -> false
